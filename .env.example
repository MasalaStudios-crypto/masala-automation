# Masala Studios - Client Research Engine
# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===== LinkedIn Credentials =====
# Your LinkedIn account email
LINKEDIN_EMAIL=your.email@example.com

# Your LinkedIn password
LINKEDIN_PASSWORD=your_password_here

# Run browser in headless mode (true/false)
HEADLESS=true

# ===== Google Sheets Integration =====
# Google Sheets API credentials (JSON key file path)
GOOGLE_SHEETS_CREDENTIALS=./config/google-credentials.json

# Target spreadsheet ID (from URL: docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/)
GOOGLE_SHEETS_ID=1zF_W4td_UKqn6-sAcRGhjzBJ51hKNgRpwUCChej69yM

# Target sheet name
GOOGLE_SHEETS_NAME=European Target Companies - Audiovisual Production Clients

# ===== Scraping Configuration =====
# Delay between requests (milliseconds)
SCRAPE_DELAY=2000

# Maximum companies to process per run
MAX_COMPANIES_PER_RUN=10

# Minimum qualification score (0-100)
MIN_QUALIFICATION_SCORE=60

# ===== Target Criteria =====
# Minimum revenue in EUR
MIN_REVENUE=10000000

# Minimum employees
MIN_EMPLOYEES=500

# Target countries (comma-separated)
TARGET_COUNTRIES=Germany,France,Netherlands,Sweden,Spain,Italy,Belgium,Switzerland,Austria,Denmark,Norway,Finland,Ireland,United Kingdom

# Target industries (comma-separated)
TARGET_INDUSTRIES=Financial Services,Technology,Luxury Goods,Manufacturing,Telecommunications,Retail,Media & Entertainment,Automotive,Energy,Pharmaceuticals,Consumer Goods

# Target roles (comma-separated)
TARGET_ROLES=Chief Marketing Officer,CMO,Head of Communications,Communications Director,Creative Director,Head of Content,Marketing Director,Brand Director,Head of Digital,Director of Marketing

# ===== Logging =====
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log directory
LOG_DIR=./logs
